# backend/.env — tout est facultatif : les valeurs ci-dessous sont les défauts.
DATABASE_URL=sqlite:///./strategy_tournament.db
CORS_ORIGINS=["http://localhost:3001"]

# Identifiants Alpaca PAPER (tableau de bord Alpaca, côté Paper ; l'identifiant
# commence par PK). Le plus simple est de les saisir dans l'application :
# Administration -> Connexions. Il n'y a volontairement aucun champ « live » :
# le broker force paper=True et ne peut pas atteindre le trading réel.
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
