# backend/.env
DATABASE_URL=sqlite:///./strategy_tournament.db
MARKET_DATA_PROVIDER=yfinance
CORS_ORIGINS=["http://localhost:3001"]
# TIINGO_API_KEY=            # optional, paid — real fundamentals (app/data/fundamentals.py)
# ANTHROPIC_API_KEY=         # optional — agentic trade explanations (app/agent/explain.py)

# Alpaca PAPER credentials — generated from the Alpaca dashboard, Paper side.
# The key ID starts with PK. A paper key cannot reach the live endpoint, and the
# broker hardcodes paper=True, so there is no live pair here by design.
# These can also be set from the app: Administration -> Connexions.
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
