# Copy to .env next to docker-compose.yml on the server.

# Encrypts the secrets stored in the database. Generate once, keep it safe,
# and reuse it if you move the data: without it, stored keys are unreadable.
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If you migrate from the Mac, use the content of backend/.secret_key instead.
STOCKSTRAT_SECRET_KEY=

# Optional: Alpaca paper keys (they can also be entered in the app).
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=

# Optional: Tailscale auth key (https://login.tailscale.com/admin/settings/keys)
# for private access from your phone: docker compose --profile tailscale up -d
TS_AUTHKEY=
